#!/usr/bin/env python3
"""Print 'light' or 'dark' for the configured coordinate at the current time.

NOAA solar position algorithm. Deterministic: same clock and same constants give
the same answer, no network and no state, so the result can be recomputed from
the Nix declaration alone.
"""
import math
from datetime import datetime, timedelta, timezone

LAT = @LAT@
LON = @LON@


def solar_events(day, lat, lon):
    """Return (sunrise, sunset) as aware UTC datetimes for that UTC date.

    sunrise precedes the date and sunset follows it, both in UTC: for a location
    east of Greenwich the local sunrise falls on the previous UTC day.
    """
    n = day.timetuple().tm_yday
    gamma = 2.0 * math.pi / 365.0 * (n - 1)

    eqtime = 229.18 * (
        0.000075
        + 0.001868 * math.cos(gamma)
        - 0.032077 * math.sin(gamma)
        - 0.014615 * math.cos(2 * gamma)
        - 0.040849 * math.sin(2 * gamma)
    )
    decl = (
        0.006918
        - 0.399912 * math.cos(gamma)
        + 0.070257 * math.sin(gamma)
        - 0.006758 * math.cos(2 * gamma)
        + 0.000907 * math.sin(2 * gamma)
        - 0.002697 * math.cos(3 * gamma)
        + 0.00148 * math.sin(3 * gamma)
    )

    lat_rad = math.radians(lat)
    # 90.833 degrees accounts for refraction and the radius of the solar disc.
    cos_ha = math.cos(math.radians(90.833)) / (
        math.cos(lat_rad) * math.cos(decl)
    ) - math.tan(lat_rad) * math.tan(decl)
    if cos_ha > 1 or cos_ha < -1:
        return None, None  # polar day or night; unreachable at this latitude
    ha = math.degrees(math.acos(cos_ha))

    base = datetime(day.year, day.month, day.day, tzinfo=timezone.utc)
    return (
        base + timedelta(minutes=720 - 4 * (lon + ha) - eqtime),
        base + timedelta(minutes=720 - 4 * (lon - ha) - eqtime),
    )


def mode_at(now):
    # The window containing `now` belongs to today or tomorrow: solar_events(D)
    # spans the sunrise before D and the sunset after it, so at 23:00 UTC the
    # sunrise of the coming local morning is tomorrow's.
    for day in (now.date(), (now + timedelta(days=1)).date()):
        sr, ss = solar_events(day, LAT, LON)
        if sr is not None and sr <= now <= ss:
            return "light"
    return "dark"


if __name__ == "__main__":
    print(mode_at(datetime.now(timezone.utc)))
