// Palette payload for niri, rendered by Noctalia at runtime.
//
// This is the payload of Noctalia's built-in "niri" template, copied verbatim.
// It is NOT used as a built-in template here: that one hardwires both its
// output path and an include appended to ~/.config/niri/config.kdl, and that
// directory belongs to dms-with-niri. The layer instead declares a user
// template (see default.nix) that renders this file into its own config
// directory, so the two desktops never write to each other's files.
//
// Every color placeholder below is filled from the active Noctalia palette;
// the values are the same ones the gtk/qt/kcolorscheme templates receive.
// Keep this comment free of literal placeholder syntax: the template engine
// tokenizes the whole file, comments included, and an unresolvable expression
// makes it drop the output instead of writing a partial file.
//
// niri merges these settings over the earlier ones positionally, so this file
// is included at the top of config.kdl and only sets colors, never widths.

layout {
    focus-ring {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.surface.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    border {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.surface.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    tab-indicator {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.primary_container.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
