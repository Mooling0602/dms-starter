// Niri config backup/template; runtime config lives in ~/.config/niri.
// DMS files are included first so they can be overridden by settings below

input {
    keyboard {
        xkb {
            layout "cn"
            model ""
            rules ""
            variant ""
        }
        repeat-delay 600
        repeat-rate 25
        track-layout "global"
    }
    touchpad {
        tap
        natural-scroll
    }
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 区域截图 → satty 标注 → 复制（全 Wayland 原生：slurp 框选 + grim 截取）
binds {
    Mod+Shift+X {
        spawn "sh" "-c" "grim -g \"$(slurp)\" - | satty --filename - --copy-command wl-copy --output-filename \"~/Pictures/Screenshots/annotated-%Y%m%d_%H%M%S.png\" --early-exit copy";
    }
    // 选区录屏开关：首次按下 slurp 选区并录制，再次按下停止并保存
    // （gpu-screen-recorder + slurp，脚本由 nixos-config 声明式部署）
    Mod+Alt+G {
        spawn "/home/mooling/.local/bin/region-record";
    }
}

spawn-at-startup "xrdb" "-merge" "/home/mooling/.Xresources"

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 24
}

environment {
    "QT_QPA_PLATFORMTHEME" "qt5ct"
    "QT_QPA_PLATFORMTHEME_QT6" "qt6ct"
    "QT_PLUGIN_PATH" "/etc/profiles/per-user/mooling/lib/qt-6/plugins:/etc/profiles/per-user/mooling/lib/qt-5.15.19/plugins"
    "QT_WAYLAND_DECORATION" "ssd"
    "QT_WAYLAND_DISABLE_WINDOWDECORATION" "1"
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}

// fcitx5 候选窗兜底：微信 beta 等 DBus-IC 应用在无 X11 父窗口时，
// 候选窗经 xwayland-satellite 退化为独立 toplevel，平铺会造成布局抖动。
// 浮动规则让其可读。候选锚定问题根治需上游支持 text-input-v3。
window-rule {
    match app-id="^fcitx$"
    open-floating true
    open-focused false
}

// DMS 生成的文件
include "dms/alttab.kdl"
include "dms/binds.kdl"
include "dms/colors.kdl"
include "dms/cursor.kdl"
include "dms/layout.kdl"
include "dms/outputs.kdl"
include "dms/windowrules.kdl"
include "dms/wpblur.kdl"
include "dms/input.kdl"
