// @id=wr_1781328897048473639 @name=zen
window-rule {
    match app-id="^zen$"
    open-maximized true
}

// @id=wr_1781358289986659464 @name=QQ音乐歌词
window-rule {
    match app-id="^qqmusic.exe$" title="桌面歌词"
    open-floating true
}

